# secrets & personal data
.env
.env.*
!.env.example
.npmrc
*.pem
*.key

# runtime output
*.log
applications*.csv
apply-state-*.json
*.png

# saved browser sessions (contain logged-in cookies)
.*-chrome-profile/
.*-apply-profile/

# resume / personal docs
*.pdf

# machine-specific launchers (contain absolute local paths)
*.vbs
# local tooling / scratch
.claude/
naukri_update/

# deps
node_modules/

# runtime flag: pauses automatic window hiding (created by show-windows.js)
.show-windows

# Docker deployment state (Chrome sessions, logs, and private documents)
runtime/
private/
