# ============================================================
#  Auto-Apply config — copy this file to ".env" and fill it in.
#  The .env file is git-ignored, so your real data never gets pushed.
# ============================================================

# --- Google account (used only to identify the account during manual login) ---
GOOGLE_EMAIL=you@gmail.com

# --- Naukri ---
# Your Naukri profile page (the default works for every account; change only if Naukri changes its URL)
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile
# Resume PDF uploaded to the Naukri profile and attached to external application forms.
# Filename relative to this folder, or an absolute path.
RESUME_FILE=Your Resume.pdf

# --- Identity / contact ---
NAME=Your Name
EMAIL=you@gmail.com
PHONE=+91 9999999999
LOCATION=City, Country
CITY=City
STATE=State
COUNTRY=Country
POSTAL_CODE=
NATIONALITY=
CITIZENSHIP=

# --- Profile ---
CURRENT_ROLE=Your Title at YourCompany (City)
COMPANY=YourCompany
EDUCATION=Your Degree, Your Institute (2021-2025)
DEGREE=Your degree name
UNIVERSITY=Your university or institute
GRADUATION_YEAR=2025
CGPA=0
CGPA_SCALE=10
TENTH_SCORE=
TENTH_YEAR=
TENTH_SCHOOL=
TENTH_BOARD=
TWELFTH_SCORE=
TWELFTH_YEAR=
TWELFTH_SCHOOL=
TWELFTH_BOARD=
YEARS_EXPERIENCE=X years professional plus internships
SKILLS=JavaScript, TypeScript, Python, React, Node.js, FastAPI, MongoDB, PostgreSQL, Docker, GCP

# Up to 5 resume highlights, separated by ||
HIGHLIGHTS=First key achievement with impact/numbers||Second achievement||Third achievement||Fourth achievement||Fifth achievement

# --- Application answers ---
NOTICE_PERIOD=30 days
CURRENT_CTC=0
EXPECTED_CTC=0
CURRENT_FIXED_CTC=
CURRENT_VARIABLE_CTC=
BONUS_DETAILS=
EXPECTED_CTC_NEGOTIABLE=
DOB=DD/MM/YYYY
GENDER=Prefer not to say
WORK_AUTH=Authorized to work in my country of residence.
WORK_SPONSORSHIP=
WORK_AUTH_INDIA=
SPONSORSHIP_INDIA=
SPONSORSHIP_OUTSIDE_INDIA=
SERVING_NOTICE_PERIOD=
LAST_WORKING_DAY=
REMOTE_PREFERENCE=Yes, I am open to remote, hybrid, and onsite roles.
RELOCATION_PREFERENCE=Yes, I am open to relocation.
MARITAL_STATUS=
DISABILITY_STATUS=Prefer not to say
DISABILITY_TYPE=
DISABILITY_PERCENTAGE=
DISABILITY_DETAILS=
CRIMINAL_RECORD=
BACKGROUND_CHECK=
SHIFT_PREFERENCE=
TRAVEL_PREFERENCE=
CONTRACT_PREFERENCE=
SERVICE_BOND_PREFERENCE=
LANGUAGES=

# Comma-separated job-title filters used by every auto-apply site.
TARGET_TITLE_KEYWORDS=backend engineer,.net developer,c# developer,software engineer,software developer
TITLE_BLOCKLIST=senior,principal,director,manager,lead,intern,qa,test,sales,marketing

# --- Links ---
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# --- Optional: Gemini API key ---
# Leave blank to keep your CV/application-question text out of Gemini. If set,
# unmatched questions and the CV data used to answer them are sent to Google Gemini.
GEMINI_KEY=

# --- Docker schedule (Asia/Kolkata) ---
# Profile refresh runs hourly at this minute.
NAUKRI_REFRESH_MINUTE=5
# Comma-separated 24-hour times. Auto-apply stays in DRY RUN unless the live flag is 1.
NAUKRI_AUTO_APPLY_TIMES=00:00,02:00,11:00,13:00,15:00,18:00,20:00
WELLFOUND_AUTO_APPLY_TIMES=00:00,02:00,11:00,13:00,15:00,18:00,20:00
AUTO_APPLY_LIVE=0
